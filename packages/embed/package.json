{
  "name": "@vassist/embed",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:types": "tsc -p ../../tsconfig.package.embed.types.json && bun ../../tools/write-package-type-entries.ts packages/embed index full chat chat-toolbar toolbar",
    "build": "vite build --config ../../vite.config.package.embed.ts && bun run build:types"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.js",
      "default": "./dist/full.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js",
      "default": "./dist/chat.js"
    },
    "./chat-toolbar": {
      "types": "./dist/chat-toolbar.d.ts",
      "import": "./dist/chat-toolbar.js",
      "default": "./dist/chat-toolbar.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar.d.ts",
      "import": "./dist/toolbar.js",
      "default": "./dist/toolbar.js"
    }
  }
}
