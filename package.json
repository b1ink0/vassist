{
  "name": "vassist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-desktop/main.js",
  "scripts": {
    "dev": "vite",
    "dev:extension": "vite build --config vite.config.extension.js --mode development --watch",
    "dev:desktop": "vite --config vite.config.desktop.js",
    "dev:android": "vite build --config vite.config.android.js --mode development && bunx cap sync android",
    "dev:android:package:models": "vite build --config vite.config.android.js --mode development -- --package-models && bunx cap sync android",
    "dev:all": "concurrently \"vite\" \"vite build --config vite.config.extension.js --mode development --watch\"",
    "dev:preview:desktop": "vite build --config vite.config.desktop.js --mode development && bunx electron .",
    "build": "vite build --mode production",
    "build:extension": "vite build --config vite.config.esxtension.js --mode production",
    "build:extension:zip": "ZIP=true vite build --config vite.config.extension.js --mode production",
    "setup:desktop:tts": "cd electron/server/gpt-sovits && python setup.py",
    "build:desktop": "vite build --config vite.config.desktop.js --mode development",
    "build:desktop:production": "vite build --config vite.config.desktop.js --mode production",
    "build:desktop:win": "electron-builder --win",
    "build:desktop:mac": "electron-builder --mac",
    "build:desktop:linux": "electron-builder --linux",
    "build:android": "vite build --config vite.config.android.js --mode production && bunx cap sync android",
    "build:android:package:models": "vite build --config vite.config.android.js --mode production -- --package-models && bunx cap sync android",
    "build:all": "concurrently \"vite build --mode production\" \"vite build --config vite.config.extension.js --mode production\"",
    "cap:open:android": "bunx cap open android",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:desktop": "bunx electron ."
  },
  "dependencies": {
    "@babylonjs/core": "^8.56.2",
    "@babylonjs/havok": "^1.3.12",
    "@capacitor/android": "^7.6.1",
    "@capacitor/cli": "^7.6.1",
    "@capacitor/core": "^7.6.1",
    "@heroicons/react": "^2.2.0",
    "@huggingface/transformers": "^3.8.1",
    "@ricky0123/vad-web": "^0.0.30",
    "@tailwindcss/vite": "^4.2.2",
    "axios": "^1.14.0",
    "babylon-mmd": "1.0.0",
    "concurrently": "^9.2.1",
    "dexie": "^4.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "multer": "^2.1.1",
    "node-llama-cpp": "^3.18.1",
    "onnxruntime-web": "^1.24.3",
    "openai": "^6.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "tailwindcss": "^4.2.2",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "archiver": "^7.0.1",
    "babel-plugin-react-compiler": "^19.1.0-rc.1-rc-af1b7da-20250421",
    "baseline-browser-mapping": "^2.10.14",
    "electron": "^39.8.6",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^11.5.0",
    "tar": "^7.5.13",
    "unbzip2-stream": "^1.4.3",
    "vite": "npm:rolldown-vite@7.1.14",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "build": {
    "appId": "com.vassist.app",
    "productName": "VAssist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-desktop/**/*",
      "electron/server/build/Release/server.node",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
